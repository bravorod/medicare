# Copy to .env and fill in. Loaded by the Makefile.

# Google Cloud project that will hold the BigQuery datasets and pay for queries.
GCP_PROJECT=your-gcp-project-id
# Prefix for the datasets dbt creates: partd_risk_staging, partd_risk_marts, ...
BQ_DATASET=partd_risk
BQ_LOCATION=US
# Safety cap on bytes billed per dbt query (200 GB by default).
BQ_MAX_BYTES_BILLED=200000000000

# dbt target: bigquery (production) or duckdb (local)
DBT_TARGET=bigquery
DUCKDB_PATH=data/warehouse/partd_risk.duckdb

# Only needed for `partd-risk export-tableau --prescriber-level`.
TABLEAU_PSEUDONYM_SALT=
